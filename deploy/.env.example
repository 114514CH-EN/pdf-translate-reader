# 复制成 deploy/.env 再填。这个文件不要提交到 git（.gitignore 已排除）。

# workspace 的登录接口：账号密码交给它验证
PDFTR_AUTH_URL=https://www.miku-api.com/api/auth

# 允许使用的 workspace 用户名，多个用英文逗号分隔
PDFTR_ALLOWED_USERS=你的workspace用户名

# 签名登录 cookie 的密钥：运行 openssl rand -hex 32 生成，填进来
PDFTR_SESSION_SECRET=

# 加密保存翻译 API Key 的密钥：同样 openssl rand -hex 32；以后不要改，改了要重新填 Key
PDFTR_SECRET_KEY=

# 登录保持多少天
PDFTR_SESSION_DAYS=30
